{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>1stG/configs"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the `npm install -g` pins in the Dockerfile up to date; one or several packages per command are read",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "npm install -g (?:\\\\\\n|[^\\n&])+",
        "(?<depName>@?[^\\s@\\\\]+)@(?<currentValue>[^\\s\\\\]+)"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
