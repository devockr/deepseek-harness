{
  "name": "idsh",
  "type": "module",
  "description": "Companion dsh plugins for the container image in this repository",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present --workspace-concurrency=1 run build",
    "deploy:dev": "pnpm dev && node tools/deploy-dev.ts",
    "deploy:dev:dry": "node tools/deploy-dev.ts --dry",
    "dev": "pnpm build && docker build --target base -t devockr/idsh:base . && docker build -f Dockerfile.dev -t devockr/idsh:dev .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "pack": "pnpm --recursive pack",
    "release": "changeset publish",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "tsc -p tsconfig.json",
    "version": "changeset version && node tools/sync-image-pins.mts && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@1stg/eslint-config": "^11.1.0",
    "@1stg/prettier-config": "^6.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "typed-query-selector": "^2.12.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
