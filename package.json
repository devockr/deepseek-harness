{
  "name": "deepseek-harness-plugins",
  "type": "module",
  "description": "Companion dsh plugins for the container image in this repository",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present --workspace-concurrency=1 run build",
    "deploy:dev": "pnpm dev && node tools/deploy-dev.ts",
    "deploy:dev:dry": "node tools/deploy-dev.ts --dry",
    "dev": "pnpm build && docker build --target base -t deepseek-harness-dsh:base . && docker build -f Dockerfile.dev -t deepseek-harness-dsh:dev .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack": "pnpm --recursive pack",
    "publish": "pnpm --recursive publish --access public",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@1stg/eslint-config": "^10.3.2",
    "@1stg/prettier-config": "^5.4.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6",
    "typescript-eslint": "^8.71.1"
  }
}
