{
  "name": "@idsh/remote-access",
  "version": "0.0.2",
  "type": "module",
  "description": "Reach a dsh Web profile from another machine: bind every interface and keep the UI's Remote-mux WebSocket alive across a flaky or proxied link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devockr/idsh.git",
    "directory": "packages/remote-access"
  },
  "license": "MIT",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "lan",
    "remote",
    "websocket",
    "heartbeat"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
