{
  "name": "@idsh/privileged-ui",
  "version": "0.1.0",
  "description": "Re-enable the loopback-only privileged surface (settings page, durable settings persistence) for a dsh Web profile served to a non-loopback origin — the deliberate exception the self-hosted image used to carry as a build-time patch",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "client",
    "remote",
    "loopback",
    "privileged"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devockr/deepseek-harness.git",
    "directory": "packages/privileged-ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
